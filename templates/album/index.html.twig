{% extends 'base.html.twig' %}

{% block title %}Hello AlbumController!{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-6">
                <div class="card h-100 shadow-sm border-0 transition">
                    <img src="{{ asset(album.cover)}}" class="card-img-top" alt="{{ album.name }}">
                    <span class="badge bg-primary position-absolute top-0 end-0 m-2">{{ album.type }}</span>
                    <div class="card-body">
                        <h5 class="card-title">{{ album.name }}</h5>
                        <p class="card-text text-muted fw-semibold">{{ album.artist.name }}</p>
                        <p class="card-text small text-secondary">{{ album.createdAt | date('d/m/Y') }}</p>
                    </div>
                </div>
            </div>

            <div class="col-6">
                {% for track in album.tracks %}
                    <a href="{{ path('app_track_item', {'id' : track.id}) }}"><p>{{ track.name }}</p></a>
                {% endfor %}
            </div>
            <a href="{{ path('app_add_track', {'id' : album.id}) }}"><button class="btn btn-primary">Ajouter un titre</button></a>
        </div>
    </div>
{% endblock %}
