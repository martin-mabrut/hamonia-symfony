{% extends 'base.html.twig' %}

{% block title %}Hello GenreController!{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-12">
                <h1>Les Morceaux {{ genre.name }} :</h1>
                <div>
                    {% for track in genre.tracks %}
                        <a href="{{ path('app_track_item', {'id': track.id}) }}"><p>{{ track.name }}</p></a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
