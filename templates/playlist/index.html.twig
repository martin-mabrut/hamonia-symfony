{% extends 'base.html.twig' %}

{% block title %}Hello PlaylistController!{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-12">
                <h1>{{ playlist.name }}</h1>
                <h2>{{ playlist.description }}</h2>
                <h3>Créée le {{ playlist.createdAt|date('d/m/Y') }} par {{ playlist.user.pseudo }}</h3>
                <div>
                    <p><strong>Morceaux :</strong></p>
                    {% for track in playlist.tracks %}
                        <a href="{{ path('app_track_item', {'id' : track.id}) }}"><p>{{ track.name }}</p></a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
