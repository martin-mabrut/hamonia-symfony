{% extends 'base.html.twig' %}

{% block body %}
<div class="container py-5">
    <div class="row g-4">
        <div class="col-12">
            <p>{{ track.name }}</p>
            <p>Genre :</p>
            {% for genre in track.genres %}
                <p>{{ genre.name }}</p>
            {% endfor %}
            <a href="{{ path('app_album_item', {'id' : track.albums.id}) }}"><p> {{ track.albums.name }}</p></a>

        </div>
    </div>
</div>
{% endblock %}
